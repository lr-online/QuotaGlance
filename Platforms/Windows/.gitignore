# Ignore duplicated checks between the four platform trees (macOS Swift,
# HarmonyOS ArkTS, Android Kotlin, Windows Rust + front end). Each tree has
# its own .gitignore; this one is Windows-specific only.

# --- Rust + Tauri build artefacts --------------------------------------------
target/
artifacts/
src-tauri/gen/schemas/
src-tauri/Cargo.lock

# Front-end Vite / TS
node_modules/
dist/
.vite-cache/
.playwright-cli/
*.tsbuildinfo

# Local Tauri override (windows GUID, debug signing, ...). Never committed.
src-tauri/tauri.conf.local.json
src-tauri/.cargo/

# Secrets and local user data (per-machine) -----------------------------------
# Generated by the Windows app on first run; do not commit.
.local/
.dev-portable/

# Generated icons (placeholder until a future scripts/generate-windows-icon
# land fills them in; see Windows/src-tauri/icons/README.md).
src-tauri/icons/*.png
src-tauri/icons/*.ico
src-tauri/icons/*.icns
!src-tauri/icons/.gitkeep
!src-tauri/icons/README.md

# Generated / sync-target content --------------------------------------------
# Both directories are produced by scripts/sync-specs-to-windows.sh and
# scripts/sync-contracts-to-windows.sh; do not commit their output.
src-tauri/assets/providerspecs/*.json
src-tauri/assets/contracts/**/*.json
!src-tauri/assets/.gitkeep
!src-tauri/assets/README.md
